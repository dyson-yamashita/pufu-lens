{
  "name": "activitypub_total_business_table_bytes",
  "description": "ActivityPub business table storage bytes from bodyless dispatcher metrics.",
  "filter": "resource.type=\"cloud_run_job\" AND jsonPayload.event=\"activitypub_queue_metrics\" AND jsonPayload.bodyless=true",
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "DISTRIBUTION",
    "unit": "By"
  },
  "valueExtractor": "EXTRACT(jsonPayload.totalBusinessTableBytes)",
  "bucketOptions": {
    "exponentialBuckets": {
      "numFiniteBuckets": 12,
      "growthFactor": 2,
      "scale": 1048576
    }
  }
}
