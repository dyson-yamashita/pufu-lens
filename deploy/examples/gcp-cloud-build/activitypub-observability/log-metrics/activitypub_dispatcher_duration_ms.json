{
  "name": "activitypub_dispatcher_duration_ms",
  "description": "ActivityPub dispatcher run duration in milliseconds from bodyless metrics.",
  "filter": "resource.type=\"cloud_run_job\" AND jsonPayload.event=\"activitypub_queue_metrics\" AND jsonPayload.bodyless=true",
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "DISTRIBUTION",
    "unit": "ms"
  },
  "valueExtractor": "EXTRACT(jsonPayload.dispatcherDurationMs)",
  "bucketOptions": {
    "exponentialBuckets": {
      "numFiniteBuckets": 12,
      "growthFactor": 2,
      "scale": 100
    }
  }
}
