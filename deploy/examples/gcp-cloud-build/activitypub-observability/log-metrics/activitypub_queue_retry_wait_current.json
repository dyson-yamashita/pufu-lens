{
  "name": "activitypub_queue_retry_wait_current",
  "description": "Current ActivityPub queue retry_wait depth.",
  "filter": "resource.type=\"cloud_run_job\" AND jsonPayload.event=\"activitypub_queue_metrics\" AND jsonPayload.bodyless=true",
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "DISTRIBUTION",
    "unit": "1"
  },
  "valueExtractor": "EXTRACT(jsonPayload.retryWaitCurrentCount)",
  "bucketOptions": {
    "linearBuckets": {
      "numFiniteBuckets": 10,
      "width": 5,
      "offset": 0
    }
  }
}
