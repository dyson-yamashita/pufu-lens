{
  "name": "activitypub_queue_depth_pending",
  "description": "ActivityPub queue pending depth from bodyless dispatcher metrics.",
  "filter": "resource.type=\"cloud_run_job\" AND jsonPayload.event=\"activitypub_queue_metrics\" AND jsonPayload.bodyless=true",
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "DISTRIBUTION",
    "unit": "1"
  },
  "valueExtractor": "EXTRACT(jsonPayload.queueDepthPending)",
  "bucketOptions": {
    "linearBuckets": {
      "numFiniteBuckets": 10,
      "width": 10,
      "offset": 0
    }
  }
}
