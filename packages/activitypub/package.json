{
  "name": "@pufu-lens/activitypub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./dependency-metadata": "./src/dependency-metadata.ts",
    "./postgres": "./src/postgres.ts",
    "./protocol": "./src/protocol.ts",
    "./queue": "./src/queue.ts",
    "./security": "./src/security.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --experimental-strip-types scripts/run-tests.ts",
    "test:db": "tsc -p tsconfig.json && ACTIVITYPUB_RUN_DB_TESTS=1 node --experimental-strip-types scripts/run-db-tests.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fedify/fedify": "2.3.4",
    "@fedify/postgres": "2.3.4",
    "@fedify/vocab": "2.3.4",
    "@fedify/vocab-runtime": "2.3.4",
    "@js-temporal/polyfill": "0.5.1",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@fedify/next": "2.3.4"
  }
}
