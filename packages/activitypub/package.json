{
  "name": "@pufu-lens/activitypub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./dependency-metadata": "./src/dependency-metadata.ts",
    "./actor-repository": "./src/actor-repository.ts",
    "./actor-use-cases": "./src/actor-use-cases.ts",
    "./federation": "./src/federation.ts",
    "./key-encryption": "./src/key-encryption.ts",
    "./schema": "./src/schema.ts",
    "./uri-contract": "./src/uri-contract.ts",
    "./postgres": "./src/postgres.ts",
    "./postgres-dispatcher": "./src/postgres-dispatcher.ts",
    "./report-publication-outbox": "./src/report-publication-outbox.ts",
    "./report-delivery": "./src/report-delivery.ts",
    "./dispatcher": "./src/dispatcher.ts",
    "./protocol": "./src/protocol.ts",
    "./queue": "./src/queue.ts",
    "./security": "./src/security.ts",
    "./inbound-report-sanitizer": "./src/inbound-report-sanitizer.ts",
    "./operations": "./src/operations.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --experimental-strip-types scripts/run-tests.ts",
    "test:db": "tsc -p tsconfig.json && ACTIVITYPUB_RUN_DB_TESTS=1 NODE_ENV=test node --experimental-strip-types scripts/run-db-tests.ts",
    "test:e2e": "tsc -p tsconfig.json && ACTIVITYPUB_RUN_DB_TESTS=1 ACTIVITYPUB_RUN_HERMETIC_E2E=1 NODE_ENV=test node --experimental-strip-types src/hermetic-e2e/hermetic-e2e.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fedify/fedify": "2.3.4",
    "@fedify/postgres": "2.3.4",
    "@fedify/vocab": "2.3.4",
    "@fedify/vocab-runtime": "2.3.4",
    "@js-temporal/polyfill": "0.5.1",
    "postgres": "3.4.9",
    "sanitize-html": "2.17.0"
  },
  "devDependencies": {
    "@fedify/next": "2.3.4",
    "@types/sanitize-html": "2.16.1"
  }
}
